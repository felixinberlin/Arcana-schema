{
  "schemaVersion": "2.0.0",
  "id": "celtic-cross",
  "name": "Celtic Cross",
  "summary": "The archetypal ten-card comprehensive inquiry spread examining core tensions, conscious and unconscious drivers, and evolutionary outcome.",
  "layoutType": "cross",
  "difficulty": "advanced",
  "author": "Arthur Edward Waite (1910)",
  "license": "CC-BY-4.0",
  "tags": ["comprehensive", "classic", "in-depth", "gold-standard"],
  "instructions": {
    "preparation": "Define a deep, multi-layered inquiry or life assessment. Ground yourself in the symbolic center.",
    "shuffle": "Shuffle methodically. If using a significator, position it before laying Slot 1.",
    "drawing": "Place Card 1 in the center, cross it with Card 2 horizontally. Lay Card 3 below, Card 4 to the left (behind), Card 5 above, Card 6 to the right (before). Lay Cards 7 through 10 as an ascending vertical staff on the right side.",
    "synthesis": "Read the small central cross (1 & 2), then the surrounding cross (3, 4, 5, 6), and finally integrate the staff of ascent (7, 8, 9, 10) pointing toward final resolution."
  },
  "deckContract": {
    "minCards": 10,
    "deckType": "full_78",
    "allowReversals": true,
    "requiresSignificator": false
  },
  "slots": [
